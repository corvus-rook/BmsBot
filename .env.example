# Copy this to .env and fill in your values
# (Never commit .env to git)

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ

# Chat ID: use @channelusername for public channels,
# or a numeric ID for groups/private chats.
# To get a group/user ID: message @userinfobot on Telegram.
TELEGRAM_CHAT_ID=-100123456789

# How often to check (seconds). Default: 120
CHECK_INTERVAL=120
